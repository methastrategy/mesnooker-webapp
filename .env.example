# Neon Postgres connection string for user accounts (optional for offline guest play; required for cloud sign-in)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/mesnooker?sslmode=require

# Random secret key for signing auth JWT session cookies (at least 32 characters)
AUTH_SECRET=your-random-32-character-secret-key-here
